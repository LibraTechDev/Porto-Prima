---
import '../styles/app.css';
import { profile } from '../data/profile';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = profile.identity.fullName,
  description = "Dedicated Software Engineer building distributed systems with Vue.js, FastAPI, Rust, PostgreSQL, & DuckDB. Portofolio bergaya Windows 8 Metro UI.",
} = Astro.props;
---

<!doctype html>
<html lang="id" data-theme="metro" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={profile.identity.fullName} />
    <meta name="keywords" content="Primavieri Rhesa Ardana, Software Engineer, Semarang, FastAPI, Rust, Vue.js, DuckDB, PostgreSQL, Fleet Management, Windows 8 Metro Portfolio" />

    <!-- Open Graph & Social Cards -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="id_ID" />
    <meta property="og:locale:alternate" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='%230078D7'><rect width='24' height='24'/><text x='50%' y='65%' font-size='12' font-family='sans-serif' font-weight='bold' fill='white' text-anchor='middle'>PR</text></svg>" />

    <!-- Google Fonts: Plus Jakarta Sans & Outfit for Ultra-High Visibility -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400;1,600&display=swap" rel="stylesheet" />

    <!-- Anti-FOUC Theme Pre-initialization -->
    <script is:inline>
      try {
        const theme = localStorage.getItem('porto_win8_theme') || 'metro';
        document.documentElement.setAttribute('data-theme', theme);
      } catch (e) {}
    </script>
  </head>
  <body class="min-h-screen flex flex-col justify-between">
    <slot />

    <!-- Client Script: Astro processes this as an ES module bundled by Vite -->
    <script src="../scripts/ui.ts"></script>
  </body>
</html>
