---
import '../styles/app.css';
import { profile } from '../data/profile';

interface Props {
  title?: string;
  description?: string;
  /** Path kanonis relatif, default mengikuti URL halaman aktif. */
  canonicalPath?: string;
  /** Path gambar OG relatif dari public/, default placeholder SVG (TODO: ganti PNG 1200x630). */
  ogImage?: string;
  /** Set true untuk halaman yang tidak boleh diindeks. */
  noindex?: boolean;
}

const {
  title = `${profile.identity.fullName} — Software Engineer`,
  description = "Dedicated Software Engineer building distributed systems with Vue.js, FastAPI, Rust, PostgreSQL, & DuckDB. Portofolio bergaya Windows 8 Metro UI.",
  canonicalPath = Astro.url?.pathname ?? '/',
  ogImage = '/og-cover.svg',
  noindex = false,
} = Astro.props;

// Canonical & OG absolut — membutuhkan `site` di astro.config.mjs.
const canonicalUrl = Astro.site
  ? new URL(canonicalPath, Astro.site).href
  : (Astro.url?.href ?? '/');
const ogImageUrl = Astro.site ? new URL(ogImage, Astro.site).href : ogImage;
const siteName = `${profile.identity.fullName} — Portfolio`;

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.identity.fullName,
  jobTitle: 'Software Engineer',
  image: new URL(profile.identity.avatar, Astro.site?.href ?? canonicalUrl).href,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Semarang',
    addressRegion: 'Central Java',
    addressCountry: 'ID',
  },
  url: Astro.site?.href ?? canonicalUrl,
  sameAs: [
    profile.contact.linkedin,
    profile.contact.github,
    profile.contact.gitlab,
    profile.contact.instagram,
  ].filter(Boolean),
  knowsAbout: [
    'Vue.js',
    'FastAPI',
    'Rust',
    'PostgreSQL',
    'DuckDB',
    'Laravel',
    'Flutter',
    'Linux server deployment',
  ],
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: siteName,
  url: Astro.site?.href ?? canonicalUrl,
  inLanguage: ['id', 'en'],
  author: { '@type': 'Person', name: profile.identity.fullName },
};
---

<!doctype html>
<html lang="id" data-theme="metro" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO inti -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={profile.identity.fullName} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="id_ID" />
    <meta property="og:locale:alternate" content="en_US" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${profile.identity.fullName} — Software Engineer Portfolio`} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#002b54" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#07080c" />

    <!-- Favicon & Manifest -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Tanpa JS, welcome screen tidak bisa di-dismiss: sembunyikan sekalian -->
    <noscript><style>#welcome-screen{display:none}</style></noscript>

    <!-- Structured data (JSON-LD) -->
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />

    <!-- Google Fonts: Plus Jakarta Sans & Outfit for Ultra-High Visibility -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400;1,600&display=swap" rel="stylesheet" />

    <!-- Anti-FOUC Theme Pre-initialization -->
    <script is:inline>
      try {
        const theme = localStorage.getItem('porto_win8_theme') || 'metro';
        document.documentElement.setAttribute('data-theme', theme);
      } catch (e) {}
    </script>
  </head>
  <body class="min-h-screen flex flex-col justify-between">
    <slot />

    <!-- Client Script: Astro processes this as an ES module bundled by Vite -->
    <script src="../scripts/ui.ts"></script>
  </body>
</html>
