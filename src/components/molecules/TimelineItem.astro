---
import TechIcon from '@/components/TechIcon.astro';

export interface Props {
  period: string | { id: string; en: string };
  role: string | { id: string; en: string };
  org: string;
  orgAccent?: string;
  location?: string | { id: string; en: string };
  description: string | { id: string; en: string };
  badges?: string[];
  metaBadges?: Array<{ label: string; tone?: string }>;
  dotTone?: string;
  align?: 'left' | 'alternate';
  index?: number;
  certificateUrl?: string;
  detailsUrl?: string;
  certLabelId?: string;
  certLabelEn?: string;
}

const {
  period, role, org, orgAccent = 'text-metro-mango', location,
  description, badges = [], metaBadges = [], dotTone = 'bg-metro-cobalt',
  align = 'alternate', index = 0, certificateUrl, detailsUrl,
  certLabelId = 'Sertifikat', certLabelEn = 'Certificate',
} = Astro.props;

const pId = typeof period === 'object' ? period.id : period;
const pEn = typeof period === 'object' ? period.en : period;
const rId = typeof role === 'object' ? role.id : role;
const rEn = typeof role === 'object' ? role.en : role;
const dId = typeof description === 'object' ? description.id : description;
const dEn = typeof description === 'object' ? description.en : description;
const lId = location ? (typeof location === 'object' ? location.id : location) : null;
const lEn = location ? (typeof location === 'object' ? location.en : location) : null;
const isLeft = align === 'alternate' ? index % 2 === 0 : false;
---
<li>
  <div class="timeline-middle">
    <div class={`w-4 h-4 ${dotTone} flex items-center justify-center`}>
      <div class="w-1.5 h-1.5 bg-white"></div>
    </div>
  </div>
  <div class={`${isLeft ? 'timeline-start md:text-end' : 'timeline-end'} mb-10 bg-black/30 p-5 border border-white/10 hover:border-white/30 transition-colors`}>
    <div class="flex items-center gap-2 flex-wrap mb-1" class:list={[isLeft ? 'md:justify-end' : '']}>
      <time class="font-mono text-xs text-metro-teal font-semibold">
        <span data-lang="id">{pId}</span>
        <span data-lang="en" style="display: none;">{pEn}</span>
      </time>
      {metaBadges.map((b) => (
        <span class={`badge badge-xs text-white border-none rounded-none text-[9px] ${b.tone ?? 'bg-white/15'}`}>{b.label}</span>
      ))}
      <slot name="meta" />
    </div>
    <h3 class="text-base sm:text-lg font-bold text-white">
      <span data-lang="id">{rId}</span>
      <span data-lang="en" style="display: none;">{rEn}</span>
    </h3>
    <div class="text-xs text-white/80 font-semibold mb-2">
      <span class={orgAccent}>{org}</span>
      {lId && (
        <>
          <span class="mx-1.5">•</span>
          <span class="text-white/60">
            <span data-lang="id">{lId}</span>
            <span data-lang="en" style="display: none;">{lEn}</span>
          </span>
        </>
      )}
      <slot name="sub" />
    </div>
    <p class="text-xs sm:text-sm text-white/80 font-light leading-relaxed mb-3">
      <span data-lang="id">{dId}</span>
      <span data-lang="en" style="display: none;">{dEn}</span>
    </p>
    {badges.length > 0 && (
      <div class="flex flex-wrap gap-1.5" class:list={[isLeft ? 'md:justify-end' : '']}>
        {badges.map((b) => (
          <span class="badge badge-xs bg-white/10 text-white/90 border-none rounded-none text-[10px] inline-flex items-center gap-1">
            <TechIcon name={b} class="w-3 h-3" />
            <span>{b}</span>
          </span>
        ))}
      </div>
    )}
    {(certificateUrl || detailsUrl) && (
      <div class="flex flex-wrap gap-2 pt-2 mt-2 border-t border-white/10" class:list={[isLeft ? 'md:justify-end' : '']}>
        {certificateUrl && (
          <a href={certificateUrl} target="_blank" rel="noopener noreferrer" class="btn btn-xs rounded-none bg-metro-mango hover:bg-metro-mango/80 text-white border-none gap-1 font-normal inline-flex items-center shadow-sm">
            <span data-lang="id">{certLabelId}</span>
            <span data-lang="en" style="display: none;">{certLabelEn}</span>
          </a>
        )}
        {detailsUrl && (
          <a href={detailsUrl} target="_blank" rel="noopener noreferrer" class="btn btn-xs rounded-none bg-white/10 hover:bg-white/20 text-white border-none gap-1 font-normal inline-flex items-center">
            <span>LinkedIn</span>
          </a>
        )}
      </div>
    )}
  </div>
  <hr class="bg-white/20" />
</li>
