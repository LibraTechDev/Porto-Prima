---
export interface Props {
  tab: string;
  active?: boolean;
  class?: string;
}
const { tab, active = false, class: className = '' } = Astro.props;
---
<button
  data-tab={tab}
  class={`drawer-nav-btn btn btn-xs rounded-none px-3 py-1 font-normal border border-white/10 transition-all ${active ? 'bg-white text-black font-bold' : 'text-white'} ${className}`}
>
  <slot />
</button>
