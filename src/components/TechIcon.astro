---
import { ICON_INNERS, normalizeIconKey } from './atoms/icons/registry';

export interface Props {
  name: string;
  class?: string;
  size?: number | string;
}

const { name = '', class: className = 'w-3.5 h-3.5 inline-block shrink-0', size } = Astro.props;
const iconKey = normalizeIconKey(name);
const { inner, fill } = ICON_INNERS[iconKey];
const sizeStyle = size ? `width:${typeof size === 'number' ? `${size}px` : size};height:${typeof size === 'number' ? `${size}px` : size};` : undefined;
---
<svg class={className} style={sizeStyle} viewBox="0 0 24 24" fill={fill ? 'currentColor' : 'none'} stroke={fill ? undefined : 'currentColor'} aria-hidden="true" set:html={inner} />
