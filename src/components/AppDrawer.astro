        <!-- Languages -->
        <div class="bg-black/30 border border-white/10 p-5 space-y-3">
          <h3 class="text-base font-semibold text-white border-b border-white/10 pb-2">
            <span data-lang="id">{i18nStrings.id.languageProficiency}</span>
            <span data-lang="en" style="display: none;">{i18nStrings.en.languageProficiency}</span>
          </h3>
          <div class="space-y-2">
            {profile.languages.map((l) => (
              <div class="flex items-center justify-between text-sm py-1.5 border-b border-white/5 last:border-none">
                <span class="text-white font-medium">
                  <span data-lang="id">{l.name.id}</span>
                  <span data-lang="en" style="display: none;">{l.name.en}</span>
                </span>
                <span class="text-xs text-white/70">
                  <span data-lang="id">{l.level.id}</span>
                  <span data-lang="en" style="display: none;">{l.level.en}</span>
                </span>
              </div>
            ))}
          </div>
        </div>

        <!-- Certificates -->
        <div class="bg-black/30 border border-white/10 p-5 space-y-3">
          <div class="flex items-center justify-between border-b border-white/10 pb-2">
            <h3 class="text-base font-semibold text-white">
              <span data-lang="id">{i18nStrings.id.certificatesTitle}</span>
              <span data-lang="en" style="display: none;">{i18nStrings.en.certificatesTitle}</span>
            </h3>
            <span class="badge badge-xs bg-metro-teal text-white border-none rounded-none text-[9px] uppercase font-bold tracking-wider">
              Verified
            </span>
          </div>
          <div class="space-y-3">
            {profile.certificates.map((c) => (
              <div class="py-2 border-b border-white/5 last:border-none flex items-start gap-3">
                <div class="mt-0.5 p-1.5 bg-white/5 border border-white/10 text-metro-mango shrink-0">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" />
                  </svg>
                </div>
                <div>
                  <div class="text-sm font-bold text-white flex flex-wrap items-center gap-2">
                    <span>{c.title}</span>
                    {c.title.includes('BNSP') && (
                      <span class="badge badge-xs bg-metro-crimson text-white border-none rounded-none text-[9px] uppercase font-bold">
                        National Credential
                      </span>
                    )}
                  </div>
                  <div class="text-xs text-white/75 font-light mt-1 leading-relaxed">
                    <span data-lang="id">{c.desc.id}</span>
                    <span data-lang="en" style="display: none;">{c.desc.en}</span>
                  </div>
                  {c.link && (
                    <div class="mt-2">
                      <a
                        href={c.link}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="btn btn-xs rounded-none bg-metro-teal hover:bg-metro-teal/80 text-white border-none gap-1 font-normal inline-flex items-center shadow-sm"
                      >
                        <span data-lang="id">Buka Sertifikat (Google Drive)</span>
                        <span data-lang="en" style="display: none;">Open Certificate (Google Drive)</span>
                        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                        </svg>
                      </a>
                    </div>
                  )}
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- ==================== TAB 6: PUBLICATIONS ==================== -->
    <section id="tab-publications" class="drawer-tab-content hidden">
      <div class="border-b border-white/15 pb-4 mb-6">
        <div class="text-xs uppercase tracking-widest text-metro-mango font-semibold">
          <span data-lang="id">Karya Ilmiah</span>
          <span data-lang="en" style="display: none;">Scientific Works</span>
        </div>
        <h2 class="text-3xl sm:text-4xl font-light text-white tracking-tight mt-1">
          <span data-lang="id">Publikasi & Desain Konseptual</span>
          <span data-lang="en" style="display: none;">Publications & Conceptual Designs</span>
        </h2>
      </div>

      <div class="space-y-6">
        {profile.publications.map((pub) => (
          <div class="bg-black/30 border border-white/10 p-6 hover:border-white/30 transition-colors flex flex-col justify-between">
            <div>
              <div class="flex flex-wrap items-center gap-2 mb-2">
                <span class="badge badge-sm rounded-none bg-metro-mango text-white border-none font-semibold uppercase text-[10px] tracking-wider">
                  {pub.journal}
                </span>
                {pub.sinta && (
                  <span class="badge badge-sm rounded-none bg-metro-emerald text-white border-none font-bold uppercase text-[10px] tracking-wider">
                    {pub.sinta}
                  </span>
                )}
                <span class="text-xs font-mono text-white/60">
                  {pub.volume} • {pub.year}
                </span>
              </div>

              <h3 class="text-xl font-bold text-white">
                <span data-lang="id">{pub.title.id}</span>
                <span data-lang="en" style="display: none;">{pub.title.en}</span>
              </h3>

              {pub.note && (
                <div class="mt-3 p-3 bg-white/5 border-l-2 border-metro-amber text-xs text-white/80">
                  <span data-lang="id">{pub.note.id}</span>
                  <span data-lang="en" style="display: none;">{pub.note.en}</span>
                </div>
              )}
            </div>

            {pub.link && (
              <div class="mt-4 pt-3 border-t border-white/10 flex flex-col sm:flex-row sm:items-center justify-between gap-2">
                <span class="text-[11px] text-white/50 font-mono truncate max-w-xs sm:max-w-md">
                  {pub.link}
                </span>
                <a
                  href={pub.link}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn btn-xs rounded-none bg-metro-mango hover:bg-metro-mango/80 text-white border-none gap-1.5 font-normal inline-flex items-center shrink-0"
                >
                  <span data-lang="id">Buka Artikel Jurnal</span>
                  <span data-lang="en" style="display: none;">Read Journal Article</span>
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                  </svg>
                </a>
              </div>
            )}
          </div>
        ))}
      </div>
    </section>

    <!-- ==================== TAB 7: EDUCATION ==================== -->
    <section id="tab-education" class="drawer-tab-content hidden">
      <div class="border-b border-white/15 pb-4 mb-6">
        <div class="text-xs uppercase tracking-widest text-metro-cobalt font-semibold">
          <span data-lang="id">Latar Belakang Akademis</span>
          <span data-lang="en" style="display: none;">Academic Background</span>
        </div>
        <h2 class="text-3xl sm:text-4xl font-light text-white tracking-tight mt-1">
          <span data-lang="id">Pendidikan Formal</span>
          <span data-lang="en" style="display: none;">Formal Education</span>
        </h2>
      </div>

      <div class="space-y-6">
        {profile.education.map((edu) => (
          <div class="bg-black/30 border border-white/10 p-6 hover:border-white/30 transition-colors">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between border-b border-white/10 pb-2 mb-3 gap-1">
              <div class="text-sm font-mono text-metro-teal">{edu.period}</div>
              <div class="flex flex-wrap gap-1.5">
                {edu.badges.map((b) => (
                  <span class="badge badge-xs rounded-none bg-white/10 text-white/80 border-none text-[10px]">{b}</span>
                ))}
              </div>
            </div>

            <h3 class="text-xl font-bold text-white">{edu.institution}</h3>

            <div class="text-sm text-white/90 font-medium mt-1">
              <span data-lang="id">{edu.degree.id} — {edu.major.id}</span>
              <span data-lang="en" style="display: none;">{edu.degree.en} — {edu.major.en}</span>
            </div>

            {edu.note && (
              <p class="text-xs text-white/70 font-light mt-2">
                <span data-lang="id">{edu.note.id}</span>
                <span data-lang="en" style="display: none;">{edu.note.en}</span>
              </p>
            )}
          </div>
        ))}
      </div>
    </section>

    <!-- ==================== TAB 8: CONTACT ==================== -->
    <section id="tab-contact" class="drawer-tab-content hidden">
      <div class="border-b border-white/15 pb-4 mb-6">
        <div class="text-xs uppercase tracking-widest text-metro-crimson font-semibold">
          <span data-lang="id">Terhubung</span>
          <span data-lang="en" style="display: none;">Get In Touch</span>
        </div>
        <h2 class="text-3xl sm:text-4xl font-light text-white tracking-tight mt-1">
          <span data-lang="id">Kontak & Jaringan Sosial</span>
          <span data-lang="en" style="display: none;">Contact & Social Networks</span>
        </h2>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        <!-- Email -->
        <a
          href={`mailto:${profile.contact.email}`}
          class="bg-metro-crimson p-5 text-white flex flex-col justify-between hover:brightness-110 transition-all cursor-pointer select-none"
        >
          <div class="text-xs uppercase tracking-wider text-white/75 font-semibold">Email</div>
          <div class="my-4 font-bold text-base truncate">{profile.contact.email}</div>
          <div class="text-xs text-white/80 flex items-center justify-between">
            <span>Kirim Pesan</span>
            <span>→</span>
          </div>
        </a>

        <!-- LinkedIn -->
        <a
          href={profile.contact.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="bg-metro-cobalt p-5 text-white flex flex-col justify-between hover:brightness-110 transition-all cursor-pointer select-none"
        >
          <div class="text-xs uppercase tracking-wider text-white/75 font-semibold">LinkedIn</div>
          <div class="my-4 font-bold text-base truncate">in/primavieri</div>
          <div class="text-xs text-white/80 flex items-center justify-between">
            <span>Buka Profil</span>
            <span>↗</span>
          </div>
        </a>

        <!-- GitLab -->
        <a
          href={profile.contact.gitlab}
          target="_blank"
          rel="noopener noreferrer"
          class="bg-metro-purple p-5 text-white flex flex-col justify-between hover:brightness-110 transition-all cursor-pointer select-none"
        >
          <div class="text-xs uppercase tracking-wider text-white/75 font-semibold">GitLab (Enterprise)</div>
          <div class="my-4 font-bold text-base truncate">gitlab.com/LibraTechDev</div>
          <div class="text-xs text-white/80 flex items-center justify-between">
            <span>Buka GitLab</span>
            <span>↗</span>
          </div>
        </a>

        <!-- GitHub -->
        <a
          href={profile.contact.github}
          target="_blank"
          rel="noopener noreferrer"
          class="bg-metro-steel p-5 text-white flex flex-col justify-between hover:brightness-110 transition-all cursor-pointer select-none"
        >
          <div class="text-xs uppercase tracking-wider text-white/75 font-semibold">GitHub</div>
          <div class="my-4 font-bold text-base truncate">github.com/LibraTechDev</div>
          <div class="text-xs text-white/80 flex items-center justify-between">
            <span>Buka Repositori</span>
            <span>↗</span>
          </div>
        </a>

        <!-- Instagram -->
        <a
          href={profile.contact.instagram}
          target="_blank"
          rel="noopener noreferrer"
          class="bg-metro-mango p-5 text-white flex flex-col justify-between hover:brightness-110 transition-all cursor-pointer select-none"
        >
          <div class="text-xs uppercase tracking-wider text-white/75 font-semibold">Instagram</div>
          <div class="my-4 font-bold text-base truncate">@prmvri</div>
          <div class="text-xs text-white/80 flex items-center justify-between">
            <span>Buka Instagram</span>
            <span>↗</span>
          </div>
        </a>

        <!-- Curriculum Vitae (PDF) -->
        <a
          href={profile.contact.cv}
          target="_blank"
          rel="noopener noreferrer"
          class="bg-metro-crimson p-5 text-white flex flex-col justify-between hover:brightness-110 transition-all cursor-pointer select-none"
        >
          <div class="text-xs uppercase tracking-wider text-white/75 font-semibold flex items-center justify-between">
            <span>Curriculum Vitae</span>
            <span class="badge badge-xs bg-white/25 text-white border-none rounded-none text-[9px] uppercase font-bold">PDF Drive</span>
          </div>
          <div class="my-4 font-bold text-base truncate">Primavieri Rhesa Ardana</div>
          <div class="text-xs text-white/80 flex items-center justify-between">
            <span data-lang="id">Unduh / Buka Dokumen CV</span>
            <span data-lang="en" style="display: none;">Download / Open CV</span>
            <span>↗</span>
          </div>
        </a>

        <!-- Location Badge -->
        <div class="bg-black/30 border border-white/10 p-5 text-white flex flex-col justify-between select-none">
          <div class="text-xs uppercase tracking-wider text-white/60 font-semibold">Domisili</div>
          <div class="my-4 font-bold text-base">Semarang, Jawa Tengah</div>
          <div class="text-xs text-white/50">Indonesia</div>
        </div>
      </div>
    </section>

  </div>
</div>
