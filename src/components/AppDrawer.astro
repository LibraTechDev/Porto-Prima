---
import { profile, i18nStrings } from '../data/profile';
import { drawerTabs } from '../data/navigation';
import ArchitectureDiagram from './ArchitectureDiagram.astro';
import TechIcon from './TechIcon.astro';
import SectionHeader from './molecules/SectionHeader.astro';
import DrawerTabButton from './molecules/DrawerTabButton.astro';
import Timeline from './organisms/Timeline.astro';
import TimelineItem from './molecules/TimelineItem.astro';
import PublicationCard from './organisms/PublicationCard.astro';
import PublicationsHeader from './organisms/PublicationsHeader.astro';
import ContactCard from './molecules/ContactCard.astro';
import { sortBySintaRank } from '../lib/sinta';

const fmsProject = profile.projects.find((p) => p.id === 'fms') || profile.projects[0];
const sortedPubs = sortBySintaRank([...profile.publications]);
---

<div id="metro-app-drawer" class="metro-app-drawer" role="dialog" aria-modal="true">
  <!-- Sticky header: action bar + mobile tab strip -->
  <div class="sticky top-0 z-50 select-none">
  <!-- Top App Bar -->
  <div class="w-full bg-black/80 border-b border-white/10 px-4 sm:px-8 py-3 flex items-center justify-between">
    <!-- Back Button -->
    <button
      id="drawer-back-btn"
      class="btn btn-sm btn-ghost rounded-none border border-white/20 text-white hover:bg-white/20 gap-2 px-3 font-normal"
    >
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
      </svg>
      <span data-lang="id">{i18nStrings.id.backToStart}</span>
      <span data-lang="en" style="display: none;">{i18nStrings.en.backToStart}</span>
    </button>

    <!-- App Navigation Tabs (data-driven) -->
    <div class="hidden lg:flex items-center space-x-1 overflow-x-auto py-1">
      {drawerTabs.map((t) => (
        <DrawerTabButton tab={t.id}>
          <span data-lang="id">{t.label.id}</span>
          <span data-lang="en" style="display: none;">{t.label.en}</span>
        </DrawerTabButton>
      ))}
    </div>

    <!-- Close Button -->
    <button
      id="drawer-close-btn"
      class="btn btn-sm btn-ghost btn-square rounded-none border border-white/20 text-white hover:bg-metro-crimson hover:border-metro-crimson"
      title="Close"
    >
      ✕
    </button>
  </div>

  <!-- Mobile/Tablet tab strip (horizontal scroll, same .drawer-nav-btn hooks) -->
  <div class="lg:hidden bg-black/80 border-b border-white/10 px-4 py-2 flex gap-1.5 overflow-x-auto">
    {drawerTabs.map((t) => (
      <DrawerTabButton tab={t.id} class="shrink-0">
        <span data-lang="id">{t.label.id}</span>
        <span data-lang="en" style="display: none;">{t.label.en}</span>
      </DrawerTabButton>
    ))}
  </div>
  </div>

  <!-- Main Drawer Body -->
  <div class="max-w-6xl w-full mx-auto px-4 sm:px-8 py-8 flex-1">

    <!-- ==================== TAB 1: ABOUT ME ==================== -->
    <section id="tab-about" class="drawer-tab-content">
      <div class="border-b border-white/15 pb-6 mb-6 flex flex-col sm:flex-row items-start sm:items-center gap-5">
        <div class="w-20 h-20 sm:w-24 sm:h-24 shrink-0 border-2 border-metro-cobalt shadow-lg overflow-hidden bg-black/40">
          <img
            src={profile.identity.avatar}
            alt={profile.identity.fullName}
            class="w-full h-full object-cover object-[center_20%]"
            width="96"
            height="96"
            loading="lazy"
          />
        </div>
        <div class="flex-1 min-w-0">
          <div class="text-xs uppercase tracking-widest text-metro-cobalt font-semibold">
            <span data-lang="id">Profil Profesional</span>
            <span data-lang="en" style="display: none;">Professional Profile</span>
          </div>
          <h2 class="text-3xl sm:text-4xl font-light text-white tracking-tight mt-1">
            {profile.identity.fullName}
          </h2>
          <p class="text-sm text-white/70 font-light mt-1">
            <span data-lang="id">{profile.identity.title.id}</span>
            <span data-lang="en" style="display: none">{profile.identity.title.en}</span>
          </p>
        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <!-- Bio & Summary -->
        <div class="lg:col-span-2 space-y-6">
          <div class="bg-black/25 p-6 border-l-4 border-metro-cobalt">
            <h3 class="text-lg font-semibold text-white mb-2">
              <span data-lang="id">Ringkasan Eksekutif</span>
              <span data-lang="en" style="display: none;">Executive Summary</span>
            </h3>
            <p class="text-white/90 leading-relaxed text-sm">
              <span data-lang="id">{profile.identity.summary.id}</span>
              <span data-lang="en" style="display: none;">{profile.identity.summary.en}</span>
            </p>
          </div>

          <div class="space-y-3">
            <h3 class="text-base font-semibold text-white">
              <span data-lang="id">Fokus & Spesialisasi</span>
              <span data-lang="en" style="display: none;">Focus & Specialization</span>
            </h3>
            <div data-lang="id" class="space-y-2">
              {profile.identity.bio.id.map((paragraph) => (
                <div class="flex items-start space-x-3 text-sm text-white/80">
                  <span class="w-1.5 h-1.5 bg-metro-teal mt-2 shrink-0"></span>
                  <span>{paragraph}</span>
                </div>
              ))}
            </div>
            <div data-lang="en" class="space-y-2" style="display: none;">
              {profile.identity.bio.en.map((paragraph) => (
                <div class="flex items-start space-x-3 text-sm text-white/80">
                  <span class="w-1.5 h-1.5 bg-metro-teal mt-2 shrink-0"></span>
                  <span>{paragraph}</span>
                </div>
              ))}
            </div>
          </div>
        </div>

        <!-- Quick Facts Panel -->
        <div class="space-y-4">
          <div class="bg-black/30 border border-white/10 p-5 space-y-4">
            <div class="text-xs uppercase tracking-wider font-semibold text-white/60 border-b border-white/10 pb-2 flex items-center justify-between">
              <div>
                <span data-lang="id">Informasi Utama</span>
                <span data-lang="en" style="display: none;">Key Information</span>
              </div>
              <span class="badge badge-xs bg-metro-cobalt text-white border-none rounded-none text-[9px] uppercase font-bold">Overview</span>
            </div>

            <!-- Dedicated CV Card -->
            <a
              href={profile.contact.cv}
              target="_blank"
              rel="noopener noreferrer"
              class="group flex items-center justify-between p-3 bg-metro-crimson hover:bg-metro-crimson/85 border border-white/20 transition-all text-white shadow-sm"
            >
              <div class="flex items-center gap-2.5">
                <div class="p-1.5 bg-black/25">
                  <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                  </svg>
                </div>
                <div>
                  <div class="text-xs font-bold uppercase tracking-wider">Curriculum Vitae (PDF)</div>
                  <div class="text-[11px] text-white/80">
                    <span data-lang="id">Unduh / Buka Dokumen CV</span>
                    <span data-lang="en" style="display: none;">Download / Open CV</span>
                  </div>
                </div>
              </div>
              <svg class="w-3.5 h-3.5 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>

            <div>
              <div class="text-xs text-white/50">
                <span data-lang="id">Lokasi</span>
                <span data-lang="en" style="display: none;">Location</span>
              </div>
              <div class="text-sm font-medium text-white">
                <span data-lang="id">{profile.identity.location.id}</span>
                <span data-lang="en" style="display: none;">{profile.identity.location.en}</span>
              </div>
            </div>

            <div>
              <div class="text-xs text-white/50">
                <span data-lang="id">Posisi Terkini</span>
                <span data-lang="en" style="display: none;">Current Role</span>
              </div>
              <div class="text-sm font-medium text-white">Fullstack Developer @ MULTI REVA PARAMA</div>
              <div class="text-xs text-white/70">Founder @ Prime Tekno</div>
            </div>

            <!-- Handled Internal Enterprise Systems -->
            <div>
              <div class="text-xs text-white/50 mb-1.5">
                <span data-lang="id">Aplikasi Internal yang Dikelola</span>
                <span data-lang="en" style="display: none;">Handled Internal Systems</span>
              </div>
              <div class="space-y-2">
                <div class="p-2.5 bg-black/40 border-l-2 border-metro-mango border-t border-r border-b border-white/10">
                  <div class="text-xs font-bold text-white flex items-center gap-1.5">
                    <TechIcon name="laravel" class="w-3.5 h-3.5" />
                    <span>Custom ERP Enterprise</span>
                  </div>
                  <div class="text-[11px] text-white/70 mt-1 flex flex-wrap items-center gap-1">
                    <span class="badge badge-xs bg-black/50 text-white/80 border-none rounded-none text-[9px] inline-flex items-center gap-1">
                      <TechIcon name="laravel" class="w-2.5 h-2.5" /> Laravel
                    </span>
                    <span class="badge badge-xs bg-black/50 text-white/80 border-none rounded-none text-[9px] inline-flex items-center gap-1">
                      <TechIcon name="blade" class="w-2.5 h-2.5" /> Blade
                    </span>
                    <span class="badge badge-xs bg-black/50 text-white/80 border-none rounded-none text-[9px] inline-flex items-center gap-1">
                      <TechIcon name="sqlserver" class="w-2.5 h-2.5" /> SQL Server
                    </span>
                    <span class="badge badge-xs bg-black/50 text-white/80 border-none rounded-none text-[9px] inline-flex items-center gap-1">
                      <TechIcon name="redis" class="w-2.5 h-2.5" /> Redis
                    </span>
                    <span class="badge badge-xs bg-black/50 text-white/80 border-none rounded-none text-[9px] inline-flex items-center gap-1">
                      <TechIcon name="linux" class="w-2.5 h-2.5" /> Linux (Pull Manual)
                    </span>
                  </div>
                </div>

                <div class="p-2.5 bg-black/40 border-l-2 border-metro-cobalt border-t border-r border-b border-white/10">
                  <div class="text-xs font-bold text-white flex items-center gap-1.5">
                    <TechIcon name="flutter" class="w-3.5 h-3.5" />
                    <span>App Internal Produksi</span>
                  </div>
                  <div class="text-[11px] text-white/70 mt-1 flex flex-wrap items-center gap-1">
                    <span class="badge badge-xs bg-black/50 text-white/80 border-none rounded-none text-[9px] inline-flex items-center gap-1">
                      <TechIcon name="api" class="w-2.5 h-2.5" /> REST API Laravel
                    </span>
                    <span class="badge badge-xs bg-black/50 text-white/80 border-none rounded-none text-[9px] inline-flex items-center gap-1">
                      <TechIcon name="flutter" class="w-2.5 h-2.5" /> Flutter Mobile
                    </span>
                    <span class="badge badge-xs bg-black/50 text-white/80 border-none rounded-none text-[9px] inline-flex items-center gap-1">
                      <TechIcon name="electron" class="w-2.5 h-2.5" /> Electron Desktop
                    </span>
                  </div>
                </div>
              </div>
            </div>

            <div>
              <div class="text-xs text-white/50">
                <span data-lang="id">Pendidikan Terakhir</span>
                <span data-lang="en" style="display: none;">Highest Education</span>
              </div>
              <div class="text-sm font-medium text-white">S1 Teknik Informatika</div>
              <div class="text-xs text-white/70">Universitas Dian Nuswantoro (UDINUS)</div>
            </div>

            <div>
              <div class="text-xs text-white/50 mb-1.5">
                <span data-lang="id">Keahlian & Ekosistem Inti</span>
                <span data-lang="en" style="display: none;">Core Tech & Ecosystem</span>
              </div>
              <div class="flex flex-wrap gap-1.5">
                <span class="badge badge-xs rounded-none bg-metro-crimson text-white border-none inline-flex items-center gap-1 py-1">
                  <TechIcon name="laravel" class="w-3 h-3" />
                  <span>Laravel</span>
                </span>
                <span class="badge badge-xs rounded-none bg-metro-cobalt text-white border-none inline-flex items-center gap-1 py-1">
                  <TechIcon name="flutter" class="w-3 h-3" />
                  <span>Flutter</span>
                </span>
                <span class="badge badge-xs rounded-none bg-metro-teal text-white border-none inline-flex items-center gap-1 py-1">
                  <TechIcon name="electron" class="w-3 h-3" />
                  <span>Electron</span>
                </span>
                <span class="badge badge-xs rounded-none bg-metro-cobalt text-white border-none inline-flex items-center gap-1 py-1">
                  <TechIcon name="sqlserver" class="w-3 h-3" />
                  <span>SQL Server</span>
                </span>
                <span class="badge badge-xs rounded-none bg-metro-crimson text-white border-none inline-flex items-center gap-1 py-1">
                  <TechIcon name="redis" class="w-3 h-3" />
                  <span>Redis</span>
                </span>
                <span class="badge badge-xs rounded-none bg-metro-emerald text-white border-none inline-flex items-center gap-1 py-1">
                  <TechIcon name="linux" class="w-3 h-3" />
                  <span>Linux</span>
                </span>
                <span class="badge badge-xs rounded-none bg-metro-cobalt text-white border-none inline-flex items-center gap-1 py-1">
                  <TechIcon name="vue" class="w-3 h-3" />
                  <span>Vue 3</span>
                </span>
                <span class="badge badge-xs rounded-none bg-metro-emerald text-white border-none inline-flex items-center gap-1 py-1">
                  <TechIcon name="fastapi" class="w-3 h-3" />
                  <span>FastAPI</span>
                </span>
                <span class="badge badge-xs rounded-none bg-metro-mango text-white border-none inline-flex items-center gap-1 py-1">
                  <TechIcon name="rust" class="w-3 h-3" />
                  <span>Rust</span>
                </span>
                <span class="badge badge-xs rounded-none bg-metro-teal text-white border-none inline-flex items-center gap-1 py-1">
                  <TechIcon name="postgresql" class="w-3 h-3" />
                  <span>PostgreSQL</span>
                </span>
                <span class="badge badge-xs rounded-none bg-metro-amber text-white border-none inline-flex items-center gap-1 py-1">
                  <TechIcon name="duckdb" class="w-3 h-3" />
                  <span>DuckDB</span>
                </span>
                <span class="badge badge-xs rounded-none bg-metro-purple text-white border-none inline-flex items-center gap-1 py-1">
                  <TechIcon name="docker" class="w-3 h-3" />
                  <span>Docker</span>
                </span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ==================== TAB 2: FEATURED FLEET MANAGEMENT SYSTEM ==================== -->
    <section id="tab-fms" class="drawer-tab-content hidden">
      <div class="border-b border-white/15 pb-4 mb-6 flex flex-col md:flex-row md:items-center justify-between gap-3">
        <div>
          <div class="flex items-center space-x-2">
            <span class="badge badge-sm rounded-none bg-metro-mango text-white border-none font-semibold uppercase tracking-wider">
              Featured Architecture
            </span>
            <span class="text-xs text-white/60">Distributed Systems & Analytics</span>
          </div>
          <h2 class="text-3xl sm:text-4xl font-light text-white tracking-tight mt-1">
            Fleet Management System
          </h2>
          <p class="text-sm text-white/80 font-light mt-1">
            <span data-lang="id">{fmsProject.tagline.id}</span>
            <span data-lang="en" style="display: none;">{fmsProject.tagline.en}</span>
          </p>
        </div>
      </div>

      <!-- Description Block -->
      <div class="bg-black/25 p-6 border-l-4 border-metro-mango mb-6">
        <p class="text-white/90 leading-relaxed text-sm sm:text-base">
          <span data-lang="id">{fmsProject.description.id}</span>
          <span data-lang="en" style="display: none;">{fmsProject.description.en}</span>
        </p>
      </div>

      <!-- Architecture Diagram Component -->
      <ArchitectureDiagram />

      <!-- Deep Dive Architectural Breakdown -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-6">
        <!-- OLTP vs OLAP -->
        <div class="bg-black/30 border border-white/10 p-5 space-y-4">
          <h4 class="text-base font-semibold text-white flex items-center gap-2 border-b border-white/10 pb-2">
            <span class="w-2.5 h-2.5 bg-metro-cobalt"></span>
            <span data-lang="id">Pemisahan Beban OLTP & OLAP</span>
            <span data-lang="en" style="display: none;">OLTP & OLAP Separation</span>
          </h4>
          <div class="text-xs sm:text-sm text-white/80 space-y-2.5">
            <p>
              <strong class="text-white">PostgreSQL (OLTP):</strong>
              <span data-lang="id"> Menangani operasi ACID transaksional seperti manajemen unit kendaraan, autentikasi sopir, dan data reservasi operasional.</span>
              <span data-lang="en" style="display: none;"> Handles transactional ACID operations including vehicle fleet catalog, driver auth, and operational reservation records.</span>
            </p>
            <p>
              <strong class="text-white">DuckDB (OLAP) + Rust Service:</strong>
              <span data-lang="id"> Service Rust mengeksekusi agregasi dashboard di atas PostgreSQL, sementara DuckDB in-process di backend mempercepat analitik dari snapshot yang disinkron tiap 5 menit tanpa membebani database operasional.</span>
              <span data-lang="en" style="display: none;"> The Rust service runs dashboard aggregations over PostgreSQL, while in-process DuckDB in the backend accelerates analytics over snapshots synced every 5 minutes without bottlenecking the operational database.</span>
            </p>
          </div>
        </div>

        <!-- Infrastructure & Security -->
        <div class="bg-black/30 border border-white/10 p-5 space-y-4">
          <h4 class="text-base font-semibold text-white flex items-center gap-2 border-b border-white/10 pb-2">
            <span class="w-2.5 h-2.5 bg-metro-emerald"></span>
            <span data-lang="id">Infrastruktur & Pengerasan Keamanan</span>
            <span data-lang="en" style="display: none;">Infrastructure & Security Hardening</span>
          </h4>
          <div class="text-xs sm:text-sm text-white/80 space-y-2.5">
            <p>
              <strong class="text-white">Automated CI/CD Pipeline (Linux VPS):</strong>
              <span data-lang="id"> Pipeline automated CI/CD untuk continuous integration & continuous deployment otomatis langsung ke server Linux VPS saat ada commit baru pada branch produksi.</span>
              <span data-lang="en" style="display: none;"> Automated CI/CD pipeline executing continuous integration & continuous deployment directly to Linux VPS on new production commits.</span>
            </p>
            <p>
              <strong class="text-white">Docker Compose & Nginx:</strong>
              <span data-lang="id"> Seluruh microservice dikemas dalam container terisolasi pada VPS dengan Nginx sebagai reverse proxy (plus kompresi gzip & rate limiting).</span>
              <span data-lang="en" style="display: none;"> Microservices are isolated in containerized VPS networks, fronted by Nginx reverse proxy with gzip compression and rate limiting.</span>
            </p>
            <p>
              <strong class="text-white">UFW, fail2ban, & GoAccess:</strong>
              <span data-lang="id"> Pertahanan firewall proaktif memblokir serangan brute force otomatis (ban auditor), sementara GoAccess menyajikan metrik akses realtime.</span>
              <span data-lang="en" style="display: none;"> Active firewall rules defend against brute-force attacks via fail2ban ban auditors, with GoAccess visualizing access logs.</span>
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ==================== TAB 3: EXPERIENCE (TIMELINE) ==================== -->
    <section id="tab-experience" class="drawer-tab-content hidden">
      <SectionHeader
        eyebrow={{ id: 'Rekam Jejak Karir', en: 'Career Track Record' }}
        eyebrowColor="text-metro-emerald"
        title={{ id: 'Pengalaman Profesional', en: 'Professional Experience' }}
        subtitle={{ id: 'Total 2+ tahun berkarya di industri perangkat lunak & organisasi teknologi', en: '2+ years across software industry & technology organizations' }}
      />

      <Timeline>
        {profile.experiences.map((exp, index) => (
          <TimelineItem
            index={index}
            period={exp.period}
            role={exp.role}
            org={exp.company}
            orgAccent="text-white"
            location={exp.location}
            description={exp.description}
            badges={exp.badges}
            dotTone={exp.isCurrent ? 'bg-metro-emerald animate-pulse' : 'bg-metro-cobalt'}
          >
            {exp.isCurrent && (
              <span slot="meta" class="badge badge-xs bg-metro-emerald text-white border-none rounded-none text-[9px] uppercase font-bold tracking-wider">
                <span data-lang="id">Sekarang</span>
                <span data-lang="en" style="display: none;">Current</span>
              </span>
            )}
          </TimelineItem>
        ))}
      </Timeline>
    </section>

    <!-- ==================== TAB: ORGANIZATIONS & LEADERSHIP ==================== -->
    <section id="tab-organizations" class="drawer-tab-content hidden">
      <div class="border-b border-white/15 pb-4 mb-6">
        <div class="text-xs uppercase tracking-widest text-metro-purple font-semibold">
          <span data-lang="id">Kepemimpinan & Organisasi Mahasiswa</span>
          <span data-lang="en" style="display: none;">Student Leadership & Organizations</span>
        </div>
        <h2 class="text-3xl sm:text-4xl font-light text-white tracking-tight mt-1">
          <span data-lang="id">Rekam Jejak Organisasi & Kepanitiaan</span>
          <span data-lang="en" style="display: none;">Organizational & Committee Track Record</span>
        </h2>
        <p class="text-sm text-white/70 font-light mt-1">
          <span data-lang="id">Kepemimpinan strategis di Dian Nuswantoro Computer Club (DNCC) dan Himpunan Mahasiswa Teknik Informatika (HMTI UDINUS)</span>
          <span data-lang="en" style="display: none;">Strategic leadership across Dian Nuswantoro Computer Club (DNCC) and Informatics Student Association (HMTI UDINUS)</span>
        </p>
      </div>

      <!-- Highlights Card (DNCC Head of R&D Integration) -->
      <div class="bg-black/35 border-l-4 border-metro-purple p-5 sm:p-6 mb-8">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
          <div class="space-y-1.5">
            <div class="flex items-center gap-2">
              <span class="badge badge-xs bg-metro-purple text-white border-none rounded-none text-[9px] uppercase font-bold tracking-wider">
                Core Leadership Term
              </span>
              <span class="text-xs font-mono text-white/60">September 2023 – Agustus 2024</span>
            </div>
            <h3 class="text-lg sm:text-xl font-bold text-white">
              Head of Research & Development (R&D) Department Specialist
            </h3>
            <div class="text-xs sm:text-sm font-semibold text-metro-mango">
              Dian Nuswantoro Computer Club (DNCC)
            </div>
            <p class="text-xs sm:text-sm text-white/80 font-light leading-relaxed max-w-4xl pt-1">
              <span data-lang="id">
